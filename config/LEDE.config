# ==============================================================================
# 目标系统架构
# ==============================================================================

# x86 体系架构目标
CONFIG_TARGET_x86=y

# 64 位 x86_64 处理器子架构
CONFIG_TARGET_x86_64=y

# 通用 x86_64 硬件目标平台
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ==============================================================================
# 磁盘与分区配置
# ==============================================================================

# 根文件系统分区大小（单位：MB）
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ==============================================================================
# 硬件驱动与无线协议
# ==============================================================================

# Realtek RTL8127 系列网卡多队列（RSS）内核驱动
CONFIG_PACKAGE_kmod-r8127-rss=y

# 联发科 MT7921/MT7922 PCIe Wi-Fi 6/6E 无线网卡内核驱动
CONFIG_PACKAGE_kmod-mt7921e=y

# 联发科 MT7922 无线网卡固件
CONFIG_PACKAGE_kmod-mt7922-firmware=y

# 支持 WPA3 加密认证的完整版 hostapd/wpa_supplicant 组件
CONFIG_PACKAGE_wpad-openssl=y

# ==============================================================================
# 常用应用与管理界面
# ==============================================================================

# SQM 智能队列管理配置界面
CONFIG_PACKAGE_luci-app-sqm=y

# ttyd 网页终端控制界面
CONFIG_PACKAGE_luci-app-ttyd=y

# uHTTPd Web 服务器管理界面
CONFIG_PACKAGE_luci-app-uhttpd=y

# Design 风格网页主题
CONFIG_PACKAGE_luci-theme-design=y

# Netlink 带宽与流量统计后台守护进程
CONFIG_PACKAGE_nlbwmon=y

# ==============================================================================
# SSR-Plus 及其代理后端
# ==============================================================================

# SSR-Plus 代理管理界面
CONFIG_PACKAGE_luci-app-ssr-plus=y

# Xray-core 协议核心组件
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y

# Mihomo 协议核心组件
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Mihomo=y

# GeoIP 与 GeoSite 规则数据库
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_GeoData=y

# Shadowsocks 客户端空实现占位
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Client=y

# Shadowsocks 服务端空实现占位
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y

# ChinaDNS-NG 防污染 DNS 分流组件
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG is not set

# HTTP/HTTPS 局部代理服务模块
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Http_Proxy is not set

# V2Ray 空选项占位
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NONE_V2RAY is not set

# shadowsocksr-libev 客户端程序
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client is not set

# ==============================================================================
# 显式禁用的功能与组件
# ==============================================================================

# Intel 集成显卡 DRM 内核驱动
# CONFIG_PACKAGE_kmod-drm-i915 is not set

# AMD 显卡 DRM 内核驱动
# CONFIG_PACKAGE_kmod-drm-amdgpu is not set

# 磁盘设备挂载管理工具
# CONFIG_PACKAGE_block-mount is not set

# 外部存储自动挂载脚本
# CONFIG_PACKAGE_automount is not set

# USB 存储设备内核驱动
# CONFIG_PACKAGE_kmod-usb-storage is not set

# CoreMark 性能基准测试工具
# CONFIG_PACKAGE_coremark is not set

# Turbo ACC 网络加速配置界面
# CONFIG_PACKAGE_luci-app-turboacc is not set

# IP/MAC 地址静态绑定插件
# CONFIG_PACKAGE_luci-app-arpbind is not set

# 定时重启任务设置插件
# CONFIG_PACKAGE_luci-app-autoreboot is not set

# DDNS 动态域名解析管理插件
# CONFIG_PACKAGE_luci-app-ddns is not set

# DDNS 核心更新脚本后端
# CONFIG_PACKAGE_ddns-scripts is not set

# 网页文件上传与安装工具
# CONFIG_PACKAGE_luci-app-filetransfer is not set

# nlbwmon 流量统计图表界面
# CONFIG_PACKAGE_luci-app-nlbwmon is not set

# UPnP 端口映射管理插件
# CONFIG_PACKAGE_luci-app-upnp is not set

# KMS 本地激活管理插件
# CONFIG_PACKAGE_luci-app-vlmcsd is not set

# vsftpd FTP 服务管理插件
# CONFIG_PACKAGE_luci-app-vsftpd is not set

# 网络唤醒（Wake-on-LAN）插件
# CONFIG_PACKAGE_luci-app-wol is not set
