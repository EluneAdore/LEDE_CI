#!/bin/sh
# ==============================================================================
# WAN 联网热插拔自愈守护脚本 (99-ssrplus-hotplug)
# ==============================================================================
# 作用:
# 1. 解决升级固件或开机时，WAN/PPPoE 建立前 SSR-Plus 提前启动导致国外节点解析失败问题；
# 2. 解决开机时系统时钟偏差导致 Xray/TLS 握手被拒问题；
# 3. 彻底避免每次升级后需要“手动再重启一次路由”的尴尬。
# ==============================================================================

[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wan" ] || [ "$INTERFACE" = "wan6" ] || exit 0

(
    # 1. 等待公网链路真正可达 (最多重试 5 次，每次间隔 2 秒)
    retries=0
    while [ $retries -lt 5 ]; do
        if ping -c 1 -W 2 223.5.5.5 >/dev/null 2>&1; then
            break
        fi
        sleep 2
        retries=$((retries + 1))
    done

    # 2. 立即触发快速 NTP 校时，确保本地时间与远程节点误差在 60s 内
    /etc/init.d/sysntpd restart >/dev/null 2>&1

    # 3. 如果启用了科学上网 (SSR-Plus)，在网络和时间就绪后自动重载一次
    if [ -f /etc/init.d/shadowsocksr ]; then
        server="$(uci -q get shadowsocksr.@global[0].global_server)"
        if [ -n "$server" ] && [ "$server" != "nil" ]; then
            sleep 1
            /etc/init.d/shadowsocksr restart >/dev/null 2>&1
        fi
    fi
) &

exit 0

