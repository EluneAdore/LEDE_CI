#!/bin/sh

# ==============================================================================
# LEDE / OpenWrt 首次开机自定义初始化与扩展配置脚本 (uci-defaults)
# ==============================================================================
# 说明:
# 1. 本脚本由 /etc/init.d/boot 在系统首次启动时执行。
# 2. 执行成功 (exit 0) 后，系统会自动删除本脚本，后续启动不再重复执行。
# 3. 所有关于网络、系统、防火墙、DNS、界面的自定义配置均集中于此维护。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 网络 LAN 口配置 (IP 与网段)
# ------------------------------------------------------------------------------
# 只有 LAN 仍是 LEDE 默认 192.168.1.1 时，才改成自定义地址（防光猫 192.168.1.1 冲突）
lan_ip="$(uci -q get network.lan.ipaddr)"
if [ "$lan_ip" = "192.168.1.1" ]; then
    uci -q set network.lan.ipaddr='192.168.2.1'
fi

# ------------------------------------------------------------------------------
# 2. WAN 口配置 (默认改为 PPPoE 拨号)
# ------------------------------------------------------------------------------
# 默认协议设为 PPPoE
uci -q set network.wan.proto='pppoe'
# 预留宽带账号与密码配置（默认留空，可在此预填或在 LuCI 界面填写）
# uci -q set network.wan.username='your_pppoe_account'
# uci -q set network.wan.password='your_pppoe_password'

# ------------------------------------------------------------------------------
# 3. 全局网络优化 (全核并发分发 RPS 与本地流导向 RFS)
# ------------------------------------------------------------------------------
# 数据包引导设为“启用 (所有 CPU)”，彻底打满所有核心并发吞吐
uci -q set network.@globals[0].packet_steering='2'
# 流量导向设为建议值 128，优化本地代理插件 (SSR-Plus/Xray/Mihomo) 的 CPU 缓存命中
uci -q set network.@globals[0].steering_flows='128'

# ------------------------------------------------------------------------------
# 4. 默认关闭 IPv6
# ------------------------------------------------------------------------------
# WAN 口关闭 IPv6
uci -q set network.wan.ipv6='0'
if uci -q get network.wan6 >/dev/null 2>&1; then
    uci -q set network.wan6.auto='0'
fi

# LAN 口清理 IPv6 前缀分配
uci -q delete network.lan.ip6assign
uci -q delete network.lan.ip6hint
uci -q delete network.lan.ip6class

# 关闭 DHCP 服务的 IPv6 RA / DHCPv6 / NDP
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ndp='disabled'

# DNS 过滤 AAAA 请求 (禁止返回 IPv6 解析)
uci -q set dhcp.@dnsmasq[0].filter_aaaa='1'

# ------------------------------------------------------------------------------
# 5. 可选配置：局域网自定义 DNS 广播下发示例 (DHCP Option 6)
# ------------------------------------------------------------------------------
# 默认已注释。如需将全屋设备 DNS 自动广播指向内网的独立 DNS/AdGuard 服务器，可取消注释并填入其 IP：
# uci -q add_list dhcp.lan.dhcp_option='6,192.168.2.X'
# uci -q add_list dhcp.lan.dns='192.168.2.X'

# ------------------------------------------------------------------------------
# 6. Dropbear SSH 安全加固
# ------------------------------------------------------------------------------
# 绑定监听接口为 LAN，关闭密码验证，禁止 root 用户凭密码登录 (仅限密钥登录)
if uci -q get dropbear.main >/dev/null 2>&1; then
    db_sec="dropbear.main"
else
    db_sec="dropbear.@dropbear[0]"
fi

uci -q set ${db_sec}.Interface='lan'
uci -q set ${db_sec}.PasswordAuth='off'
uci -q set ${db_sec}.RootPasswordAuth='off'

# ------------------------------------------------------------------------------
# 7. 防火墙配置 (启用 FullCone NAT)
# ------------------------------------------------------------------------------
# 启用 FullCone NAT (通用兼容模式 1: FULLCONE_CHION，非 Broadcom Fullcone NAT1)
uci -q set firewall.@defaults[0].fullcone='1'


# ------------------------------------------------------------------------------
# 8. 可选配置：系统主机名与 Banner 提示
# ------------------------------------------------------------------------------
# 如需修改默认主机名 (默认 LEDE)，取消注释：
# uci -q set system.@system[0].hostname='LEDE-Router'
# uci commit system

# 如需自定义 SSH 终端登录横幅，取消注释以下内容：
# cat << 'BANNER_EOF' > /etc/banner
#   _______                     ________        __
#  |       |.-----.-----.-----.|  |  |  |.----.|  |_
#  |   -   ||  _  |  -__|     ||  |  |  ||   _||   _|
#  |_______||   __|_____|__|__||________||__|  |____|
#           |__| W I R E L E S S   F R E E D O M
#  -----------------------------------------------------
#   Custom LEDE x86_64 Gateway (192.168.2.1)
#  -----------------------------------------------------
# BANNER_EOF

# ------------------------------------------------------------------------------
# 9. 计划任务维护与定时重启示例
# ------------------------------------------------------------------------------
# 彻底移除 coremark 定时任务与临时跑分日志 (兼容保留配置升级场景)
sed -i '/coremark/d' /etc/crontabs/root 2>/dev/null
rm -f /etc/coremark.sh /etc/bench.log /tmp/coremark.log 2>/dev/null

# 预置定时重启示例 (默认注释未生效，如需启用删除最前面的 # 并在后台保存即可)
mkdir -p /etc/crontabs
if ! grep -q "定时重启示例" /etc/crontabs/root 2>/dev/null; then
    cat << 'CRON_EOF' >> /etc/crontabs/root

# ==============================================================================
# [定时重启示例] 语法格式: 分 时 日 月 周 命令
# 默认已注释。如需启用，请删除目标行开头的 '#' 并在管理后台点击【保存并应用】
# 注：加入 'sleep 70' 可跨过触发分钟，防止 x86 设备启动过快导致 1 分钟内连续重启
# ==============================================================================
# 示例一：每天凌晨 04:30 自动安全重启
# 30 4 * * * sleep 70 && touch /etc/banner && reboot
#
# 示例二：每周一凌晨 04:30 自动安全重启
# 30 4 * * 1 sleep 70 && touch /etc/banner && reboot
CRON_EOF
fi

# ------------------------------------------------------------------------------
# 10. 提交所有 UCI 配置变更
# ------------------------------------------------------------------------------
uci commit network
uci commit dhcp
uci commit dropbear
uci commit firewall

exit 0

